{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Windows EXE",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/scripts/build.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Run application",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/run_app.py", "--data-dir", "${workspaceFolder}/.dev-data"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    }
  ]
}
